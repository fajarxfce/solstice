# Rust
/target/
**/*.rs.bk

# Benchmark + simulation artefacts
/bench/out/
/crates/solstice-sim/failures/

# Spike S1 — all regenerable: fixtures from `s1-fixture`, decoders from
# `generate.sh`. Committing generated protobuf code would let it drift from the
# .proto it is supposed to be an independent check on.
/spikes/s1-decode/fixtures/
/spikes/s1-decode/dart/lib/gen/
/spikes/s1-decode/dart/lib/gen32/
/spikes/s1-decode/kotlin/gen/
/spikes/s1-decode/kotlin/lib/

# Spike S2 — same rule, one exception. Everything four generators write into the
# spike is regenerable by `generate.sh` and stays out; the jars `kotlin/run.sh`
# fetches stay out with them.
#
# The exception is `crates/solstice-ffi-dart/src/frb_generated.rs`, which is
# committed: it is a module of a workspace crate, so without it `cargo build`
# fails for anyone who has not installed `flutter_rust_bridge_codegen`. Its Dart
# counterpart is ignored anyway — the two are written by one run of the
# generator, so they cannot drift apart.
/spikes/s2-bridge/dart/lib/gen/
/spikes/s2-bridge/dart/lib/src/rust/
/spikes/s2-bridge/kotlin/gen/
/spikes/s2-bridge/kotlin/lib/

# Dart / Flutter
.dart_tool/
.packages
build/
*.iml

# Kotlin / Gradle
.gradle/
local.properties
.kotlin/

# Editors
.idea/
.vscode/
*.swp

# OS
.DS_Store
